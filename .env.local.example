# Fine Print Fighter — environment variables
# Copy to .env.local and fill in your keys.

# Nebius Token Factory — NVIDIA Nemotron model
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning

# Tavily search (optional; leave unset for limited keyless mode)
# TAVILY_API_KEY=

# Required for production analysis; shared Upstash budget, not local development.
# Keep the Upstash token and hash secret on the server.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_HASH_SECRET=
# Choose this only after estimating the provider's maximum per-run cost.
# MAX_PUBLIC_ANALYSES_PER_DAY=
# TRUSTED_CLIENT_IP_HEADER=x-vercel-forwarded-for
