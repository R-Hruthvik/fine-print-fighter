{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "../.test-build",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../src/lib/**/*.ts", "../src/rule-packs/*.json"],
  "exclude": ["../node_modules"]
}
